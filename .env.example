# Це ЗРАЗОК файлу з налаштуваннями. Він лежить у git, але без справжніх паролів.
# Щоб запустити проєкт у себе: скопіюй цей файл у файл з назвою .env
# і встав туди свої справжні значення.
#
#   cp .env.example .env

# Рядок підключення до бази Postgres (беремо в панелі Neon → Connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Те саме, але пряме підключення — та сама адреса без "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"
