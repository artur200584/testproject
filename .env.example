# Це ЗРАЗОК файлу з налаштуваннями. Він лежить у git, але без справжніх паролів.
# Щоб запустити проєкт у себе: скопіюй цей файл у файл з назвою .env
# і встав туди свої справжні значення.
#
#   cp .env.example .env

# Рядок підключення до бази Postgres (беремо в панелі Neon → Connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"

# Те саме, але пряме підключення — та сама адреса без "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"

# Секретний ключ для підпису токенів входу.
# Свій власний можна згенерувати командою:  openssl rand -base64 32
AUTH_SECRET=""

# Ключі для входу через Google (як їх отримати — написано в README).
# Якщо залишити порожніми, сайт працює, але кнопка "Увійти через Google" вимкнена.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
